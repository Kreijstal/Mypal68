NoVisibilityFlags()

os_target = '%s' % CONFIG["OS_TARGET"]

EXPORTS.mozilla += [
    "VolatileBuffer.h",
]

if os_target == "Android":
    UNIFIED_SOURCES += [
        "VolatileBufferAshmem.cpp",
    ]
elif os_target == "Darwin":
    UNIFIED_SOURCES += [
        "VolatileBufferOSX.cpp",
    ]
elif os_target == "WINNT":
    UNIFIED_SOURCES += [
        "VolatileBufferWindows.cpp",
    ]
else:
    UNIFIED_SOURCES += [
        "VolatileBufferFallback.cpp",
    ]

FINAL_LIBRARY = "xul"

TEST_DIRS += ["tests"]
